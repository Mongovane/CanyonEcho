<hc:Window x:Class="CanyonEcho_Wpf.Views.MainWindow"
           xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
           xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
           xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
           xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
           xmlns:local="clr-namespace:CanyonEcho_Wpf"
           xmlns:hc="https://handyorg.github.io/handycontrol"
           xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
           xmlns:const="clr-namespace:CanyonEcho_Wpf.Constants"
           xmlns:prism="http://prismlibrary.com/"
           xmlns:conv="clr-namespace:CanyonEcho_Wpf.Views.Conveters"
           prism:ViewModelLocator.AutoWireViewModel="True"
           mc:Ignorable="d" WindowStartupLocation="CenterScreen"
           hc:Dialog.Token="{x:Static const:DialogTokens.MainWindow}"
           Title="{x:Static const:Titles.Main}" Height="510" Width="460" Icon="/Assets/Images/祖安.ico" StateChanged="Window_StateChanged" ResizeMode="CanMinimize">
  <Window.Resources>
    <Style x:Key="NotifyBtn"
           TargetType="Button" BasedOn="{StaticResource ButtonDefault}">
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Width" Value="100"/>
      <Setter Property="HorizontalContentAlignment" Value="Left"/>
    </Style>
    <conv:Bool2Brush x:Key="Bool2Brush"/>
  </Window.Resources>

  <hc:Window.NonClientAreaContent>
    <Grid>
      <Grid.ColumnDefinitions>
        <ColumnDefinition/>
        <ColumnDefinition Width="auto"/>
      </Grid.ColumnDefinitions>
      <StackPanel VerticalAlignment="Stretch" Orientation="Horizontal" Margin="5,0,0,0">
        <Button Content="{Binding Version}" Foreground="{Binding NeedUpdate,Converter={StaticResource Bool2Brush}}" BorderThickness="0" VerticalAlignment="Center" Command="{Binding UpdateCommand}"/>
        <Button BorderThickness="0" ToolTip="GitHub" Command="{Binding VisitGitHubCommand}" Margin="10,0,0,0">
          <Image Source="/Assets/Images/github.png"/>
        </Button>
        <Button BorderThickness="0" ToolTip="交流群">
          <Image Source="/Assets/Images/QQ.png"/>
          <hc:Poptip.Instance>
            <hc:Poptip PlacementType="Bottom">
              <hc:Poptip.Content>
                <Image Source="/Assets/Images/祖安助手使用交流群群聊二维码.png"/>
              </hc:Poptip.Content>
            </hc:Poptip>
          </hc:Poptip.Instance>
        </Button>
      </StackPanel>
      <StackPanel Grid.Column="1" Orientation="Horizontal">
        <Button Content="AI/OCR设置" ToolTip="配置 LLM 大模型、DPAPI 加密密钥、内置阴阳怪气风格与聊天框坐标"
                Command="{Binding AiSetCommand}" BorderThickness="0" Margin="0,0,4,0"/>
        <Button ToolTip="词库管理"
                Command="{Binding SetCommand}" BorderThickness="0"
                hc:IconElement.Geometry="{StaticResource ConfigGeometry}"/>
      </StackPanel>
    </Grid>
  </hc:Window.NonClientAreaContent>

  <i:Interaction.Triggers>
    <i:EventTrigger EventName="Loaded">
      <i:InvokeCommandAction Command="{Binding LoadedCommand}"/>
    </i:EventTrigger>
  </i:Interaction.Triggers>

  <Grid>
    <hc:NotifyIcon
      Token="NotifyIconToken" x:Name="notifyIcon" Text="峡谷回音 (CanyonEcho)" IsBlink="{Binding IsNotifyIconBlink}" Visibility="{Binding IsNotifyIconShow,Converter={StaticResource Boolean2VisibilityConverter}}" MouseDoubleClick="Button_Click" Icon="/Assets/Images/祖安.ico">
      <hc:NotifyIcon.ContextContent>
        <Border CornerRadius="4" Margin="5" Effect="{StaticResource EffectShadow2}" Background="{DynamicResource {x:Static SystemColors.WindowBrushKey}}" >
          <StackPanel Margin="10" VerticalAlignment="Center">
            <Grid Margin="12,5,0,0">
              <TextBlock Text="所有人" HorizontalAlignment="Left" VerticalAlignment="Center"/>
              <CheckBox x:Name="checkBox_isAll_notifyIcon" HorizontalAlignment="Right" VerticalAlignment="Center"/>
            </Grid>
            <Grid Margin="12,5,0,0">
              <TextBlock Text="逐字发送" HorizontalAlignment="Left" VerticalAlignment="Center"/>
              <CheckBox x:Name="checkBox_isPerword_notifyIcon" HorizontalAlignment="Right" VerticalAlignment="Center"/>
            </Grid>
            <hc:Divider VerticalAlignment="Center" Margin="10,10,0,10" LineStrokeDashArray="2,2" LineStroke="#FFA5A5A5"/>
            <Button Content="显示主界面" Click="Button_Click" Style="{StaticResource NotifyBtn}"/>
            <Button Content="退出" Click="Button_Quit_Click" Style="{StaticResource NotifyBtn}"/>
          </StackPanel>
        </Border>
      </hc:NotifyIcon.ContextContent>
    </hc:NotifyIcon>

    <Grid Margin="10">
      <Grid.RowDefinitions>
        <RowDefinition Height="*"/>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="Auto"/>
      </Grid.RowDefinitions>

      <Border BorderBrush="Black" BorderThickness="1">
        <Grid ShowGridLines="True">
          <Grid.RowDefinitions>
            <RowDefinition Height="30"/>
            <RowDefinition/>
            <RowDefinition/>
            <RowDefinition/>
            <RowDefinition/>
            <RowDefinition/>
            <RowDefinition/>
            <RowDefinition/>
            <RowDefinition/>
            <RowDefinition/>
          </Grid.RowDefinitions>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="100"/>
            <ColumnDefinition Width="*"/>
          </Grid.ColumnDefinitions>

          <TextBlock Text="热键" VerticalAlignment="Center" HorizontalAlignment="Center" FontWeight="Bold" FontStyle="Italic"/>
          <TextBlock Grid.Column="1" Text="功能说明" VerticalAlignment="Center" HorizontalAlignment="Center" FontWeight="Bold" FontStyle="Italic"/>

          <TextBlock Grid.Column="0" Grid.Row="1" Text="F2" HorizontalAlignment="Center" VerticalAlignment="Center"/>
          <TextBlock Grid.Column="1" Grid.Row="1" Text="默认词库（智能防重随机发送）" HorizontalAlignment="Center" VerticalAlignment="Center"/>

          <TextBlock Grid.Column="0" Grid.Row="2" Text="F3" HorizontalAlignment="Center" VerticalAlignment="Center"/>
          <TextBlock Grid.Column="1" Grid.Row="2" Text="自定义词库（智能防重随机发送）" HorizontalAlignment="Center" VerticalAlignment="Center"/>

          <TextBlock Grid.Column="0" Grid.Row="3" Text="F4" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#FFD9534F" FontWeight="Bold"/>
          <TextBlock Grid.Column="1" Grid.Row="3" Text="手动框选截图 OCR -> AI/内置阴阳怪气反击" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#FFD9534F" FontWeight="SemiBold"/>

          <TextBlock Grid.Column="0" Grid.Row="4" Text="F5" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#FF0275D8" FontWeight="Bold"/>
          <TextBlock Grid.Column="1" Grid.Row="4" Text="静默截取聊天框 OCR -> AI/内置阴阳怪气反击" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#FF0275D8" FontWeight="SemiBold"/>

          <TextBlock Grid.Column="0" Grid.Row="5" Text="F6" HorizontalAlignment="Center" VerticalAlignment="Center"/>
          <TextBlock Grid.Column="1" Grid.Row="5" Text="内置阴阳怪气词库（直接随机发送）" HorizontalAlignment="Center" VerticalAlignment="Center"/>

          <TextBlock Grid.Column="0" Grid.Row="6" Text="F7" HorizontalAlignment="Center" VerticalAlignment="Center"/>
          <CheckBox Grid.Column="1" Grid.Row="6" Content="游戏内安全透明悬浮窗 HUD（鼠标穿透零风险）" IsChecked="{Binding IsOverlayVisible}" HorizontalAlignment="Center"/>

          <TextBlock Grid.Column="0" Grid.Row="7" Text="F8" HorizontalAlignment="Center" VerticalAlignment="Center"/>
          <CheckBox Grid.Column="1" Grid.Row="7" Content="单行零宽字符穿插（不刷屏绕过屏蔽词）" IsChecked="{Binding IsZeroWidthAntiFilter}" HorizontalAlignment="Center"/>

          <TextBlock Grid.Column="0" Grid.Row="8" Text="F11" HorizontalAlignment="Center" VerticalAlignment="Center"/>
          <CheckBox x:Name="checkBox_isAll" Grid.Column="1" Grid.Row="8" Content="所有人 (/all)" IsChecked="{Binding IsAll}" HorizontalAlignment="Center"/>

          <TextBlock Grid.Column="0" Grid.Row="9" Text="F12" HorizontalAlignment="Center" VerticalAlignment="Center"/>
          <CheckBox x:Name="checkBox_isPerword" Grid.Column="1" Grid.Row="9" Content="逐字纵向发送（原版防屏蔽）" IsChecked="{Binding IsPerWord}" HorizontalAlignment="Center"/>
        </Grid>
      </Border>

      <UniformGrid Grid.Row="1" Columns="3" Margin="0,8,0,0">
        <Button Content="🎯 手动截图反击 (F4)" Command="{Binding ManualSnipOcrCommand}" Margin="0,0,4,0"/>
        <Button Content="⚡ 快速识图反击 (F5)" Command="{Binding QuickChatOcrCommand}" Margin="2,0,2,0"/>
        <Button Content="⚙️ AI / OCR 配置" Command="{Binding AiSetCommand}" Margin="4,0,0,0"/>
      </UniformGrid>

      <Border Grid.Row="2" Margin="0,8,0,0" Padding="8,6" Background="#FFF7F9FC" BorderBrush="#FFD0D7DE" BorderThickness="1" CornerRadius="4">
        <StackPanel>
          <TextBlock Text="{Binding LastOcrText}" FontSize="11" Foreground="#FF555555" TextTrimming="CharacterEllipsis" ToolTip="{Binding LastOcrText}"/>
          <TextBlock Text="{Binding LastAiReply}" FontSize="12" Foreground="#FF005CC5" FontWeight="SemiBold" Margin="0,3,0,0" TextTrimming="CharacterEllipsis" ToolTip="{Binding LastAiReply}"/>
        </StackPanel>
      </Border>
    </Grid>
  </Grid>
</hc:Window>
