<UserControl x:Class="CanyonEcho_Wpf.Views.AiSettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:prism="http://prismlibrary.com/"
             xmlns:helper="clr-namespace:CanyonEcho_Wpf.Helper"
             xmlns:sys="clr-namespace:System;assembly=mscorlib"
             prism:ViewModelLocator.AutoWireViewModel="True"
             mc:Ignorable="d"
             d:DesignHeight="560" d:DesignWidth="660">
  <prism:Dialog.WindowStyle>
    <Style TargetType="Window">
      <Setter Property="Height" Value="580"/>
      <Setter Property="Width" Value="680"/>
      <Setter Property="prism:Dialog.WindowStartupLocation" Value="CenterScreen"/>
    </Style>
  </prism:Dialog.WindowStyle>

  <UserControl.Resources>
    <ObjectDataProvider x:Key="EngineModeValues" MethodName="GetValues" ObjectType="{x:Type sys:Enum}">
      <ObjectDataProvider.MethodParameters>
        <x:Type TypeName="helper:ReplyEngineMode"/>
      </ObjectDataProvider.MethodParameters>
    </ObjectDataProvider>
    <ObjectDataProvider x:Key="StylePresetValues" MethodName="GetValues" ObjectType="{x:Type sys:Enum}">
      <ObjectDataProvider.MethodParameters>
        <x:Type TypeName="helper:SnarkyStylePreset"/>
      </ObjectDataProvider.MethodParameters>
    </ObjectDataProvider>
  </UserControl.Resources>

  <Grid Margin="14">
    <Grid.RowDefinitions>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
      <StackPanel>
        <!-- 1. 引擎模式与风格选择 -->
        <GroupBox Header="1. 反击引擎模式与阴阳怪气风格" Margin="0,0,0,8" Padding="10">
          <Grid>
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="120"/>
              <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <TextBlock Text="反击引擎模式：" VerticalAlignment="Center" Margin="0,4"/>
            <ComboBox Grid.Column="1" SelectedItem="{Binding Config.EngineMode}" ItemsSource="{Binding Source={StaticResource EngineModeValues}}" Margin="0,4" ToolTip="HybridAuto=优先LLM，失败或无Key自动用内置离线引擎；LlmOnly=仅用大模型；BuiltInOnly=纯内置离线免Key"/>

            <TextBlock Grid.Row="1" Text="阴阳怪气人设：" VerticalAlignment="Center" Margin="0,4"/>
            <ComboBox Grid.Row="1" Grid.Column="1" SelectedItem="{Binding Config.StylePreset}" ItemsSource="{Binding Source={StaticResource StylePresetValues}}" Margin="0,4" ToolTip="GreenTea=绿茶茶言茶语；PoliteScholar=温和理智怪；KindPhilanthropist=大善人关怀；CanyonPoet=祖安文豪反讽"/>

            <WrapPanel Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2" Orientation="Horizontal" Margin="0,6,0,0">
              <CheckBox Content="识别后自动发送到游戏" IsChecked="{Binding Config.AutoSendToGame}" Margin="0,4,16,0"/>
              <CheckBox Content="极速剪贴板防吞字发送(Ctrl+V)" IsChecked="{Binding Config.UseFastClipboardSend}" Margin="0,4,16,0"/>
              <CheckBox Content="单行零宽字符防屏蔽(F8)" IsChecked="{Binding Config.UseZeroWidthAntiFilter}" Margin="0,4,16,0"/>
              <CheckBox Content="游戏内安全穿透悬浮窗HUD(F7)" IsChecked="{Binding Config.ShowInGameOverlay}" Margin="0,4,16,0"/>
              <CheckBox Content="仅检测到恶意/问号才反击" IsChecked="{Binding Config.OnlyReplyToMalicious}" Margin="0,4,16,0"/>
              <CheckBox Content="粗口 Roast 骂人模式 (脏话拉满, 默认开)" IsChecked="{Binding Config.UseRoastMode}" Margin="0,4,16,0" ToolTip="开: LLM 和内置引擎都用中文俚语+大量脏话往死里喷。关: 回到干净阴阳怪气。开着被举报/禁言/封号风险自担"/>
              <CheckBox Content="脏话隐形处理 (同音/变体/零宽, 防吞字, 默认开)" IsChecked="{Binding Config.UseSwearObfuscation}" Margin="0,4,16,0" ToolTip="开: 发送前把原形脏话换成艹/尼玛/特么/傻B等隐形写法, 并在脏话词内插零宽, 免得硬骂被聊天框吞掉。关: 原样发"/>
              <TextBlock Text="⚠ 粗口模式会触发 LoL 聊天过滤与举报, 零宽防屏蔽 (F8) 不是免死金牌, 封号了别找我。" Foreground="Red" FontSize="11" Margin="0,4,0,0" TextWrapping="Wrap"/>
              <CheckBox Content="手动截图后记忆坐标供F5使用" IsChecked="{Binding Config.RememberLastSnipRegion}" Margin="0,4,0,0"/>
            </WrapPanel>
          </Grid>
        </GroupBox>

        <!-- 2. LLM 接口配置 -->
        <GroupBox Header="2. LLM 大模型接入配置（支持 OpenAI 兼容接口，不填 Key 自动使用内置离线引擎）" Margin="0,0,0,8" Padding="10">
          <StackPanel>
            <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
              <TextBlock Text="一键预设：" VerticalAlignment="Center" Margin="0,0,6,0"/>
              <Button Content="DeepSeek" Command="{Binding ApplyPresetCommand}" CommandParameter="DeepSeek" Margin="0,0,6,0" Padding="8,2"/>
              <Button Content="xAI Grok" Command="{Binding ApplyPresetCommand}" CommandParameter="Grok" Margin="0,0,6,0" Padding="8,2"/>
              <Button Content="OpenAI" Command="{Binding ApplyPresetCommand}" CommandParameter="OpenAI" Margin="0,0,6,0" Padding="8,2"/>
              <Button Content="通义千问" Command="{Binding ApplyPresetCommand}" CommandParameter="Qwen" Margin="0,0,6,0" Padding="8,2"/>
              <Button Content="Kimi" Command="{Binding ApplyPresetCommand}" CommandParameter="Kimi" Margin="0,0,6,0" Padding="8,2"/>
              <Button Content="本地 Ollama" Command="{Binding ApplyPresetCommand}" CommandParameter="Ollama" Padding="8,2"/>
            </StackPanel>

            <Grid>
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
              </Grid.RowDefinitions>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="120"/>
                <ColumnDefinition Width="*"/>
              </Grid.ColumnDefinitions>

              <TextBlock Text="API 接口地址：" VerticalAlignment="Center" Margin="0,4"/>
              <TextBox Grid.Column="1" Text="{Binding Config.ApiBaseUrl, UpdateSourceTrigger=PropertyChanged}" Margin="0,4"/>

              <TextBlock Grid.Row="1" Text="API Key 密钥：" VerticalAlignment="Center" Margin="0,4"/>
              <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding Config.ApiKey, UpdateSourceTrigger=PropertyChanged}" Margin="0,4" ToolTip="留空时在 HybridAuto 模式下会自动使用内置离线阴阳怪气引擎"/>

              <TextBlock Grid.Row="2" Text="模型名称 (Model)：" VerticalAlignment="Center" Margin="0,4"/>
              <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding Config.ModelName, UpdateSourceTrigger=PropertyChanged}" Margin="0,4"/>

              <TextBlock Grid.Row="3" Text="自定义提示词：" VerticalAlignment="Top" Margin="0,6,0,0"/>
              <TextBox Grid.Row="3" Grid.Column="1" Text="{Binding Config.CustomSystemPrompt, UpdateSourceTrigger=PropertyChanged}" Height="46" TextWrapping="Wrap" AcceptsReturn="True" Margin="0,4"/>
            </Grid>
          </StackPanel>
        </GroupBox>

        <!-- 3. 英雄联盟聊天框区域标定 & 效果测试 -->
        <GroupBox Header="3. 聊天框自动识别区域标定 (F5) 与反击效果测试" Padding="10">
          <StackPanel>
            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
              <Button Content="🎯 框选标定 LOL 聊天框位置" Command="{Binding CalibrateRegionCommand}" Padding="10,4" Margin="0,0,8,0"/>
              <Button Content="重置为默认左下角" Command="{Binding ResetRegionCommand}" Padding="10,4" Margin="0,0,12,0"/>
              <TextBlock VerticalAlignment="Center" Foreground="Gray">
                <Run Text="当前坐标：X="/>
                <Run Text="{Binding Config.ChatBoxX}"/>
                <Run Text=", Y="/>
                <Run Text="{Binding Config.ChatBoxY}"/>
                <Run Text=", W="/>
                <Run Text="{Binding Config.ChatBoxWidth}"/>
                <Run Text=", H="/>
                <Run Text="{Binding Config.ChatBoxHeight}"/>
              </TextBlock>
            </StackPanel>

            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
              </Grid.ColumnDefinitions>
              <TextBox Text="{Binding TestInputText, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,8,0" ToolTip="输入模拟的聊天框恶意言论进行测试"/>
              <Button Grid.Column="1" Content="⚡ 测试阴阳怪气反击" Command="{Binding TestGenerateCommand}" Padding="12,4"/>
            </Grid>
            <TextBlock Text="{Binding TestResultText}" Margin="0,6,0,0" Foreground="#FF0066CC" TextWrapping="Wrap" FontWeight="SemiBold"/>
          </StackPanel>
        </GroupBox>
      </StackPanel>
    </ScrollViewer>

    <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
      <Button Content="保存设置" Command="{Binding SaveCommand}" Style="{StaticResource ButtonPrimary}" Width="110" Margin="0,0,12,0" IsDefault="True"/>
      <Button Content="取消" Command="{Binding CancelCommand}" Width="100" IsCancel="True"/>
    </StackPanel>
  </Grid>
</UserControl>
