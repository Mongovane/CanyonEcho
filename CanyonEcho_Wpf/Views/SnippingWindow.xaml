<Window x:Class="CanyonEcho_Wpf.Views.SnippingWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="框选英雄联盟聊天框"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="#55000000"
        Topmost="True"
        ShowInTaskbar="False"
        Cursor="Cross"
        KeyDown="Window_KeyDown"
        MouseLeftButtonDown="Window_MouseLeftButtonDown"
        MouseMove="Window_MouseMove"
        MouseLeftButtonUp="Window_MouseLeftButtonUp">
  <Canvas x:Name="DragCanvas">
    <!-- 顶部操作提示条 -->
    <Border Canvas.Left="20" Canvas.Top="20" Background="#CC1E1E2E" CornerRadius="6" Padding="14,8" BorderBrush="#FF00D1B2" BorderThickness="1">
      <StackPanel Orientation="Horizontal">
        <TextBlock Text="🎯 按住鼠标左键框选【英雄联盟聊天框】中的恶意言论，松开鼠标自动 OCR 识别并阴阳怪气反击 | 按 ESC 取消"
                   Foreground="White" FontSize="13" FontWeight="Bold"/>
      </StackPanel>
    </Border>

    <!-- 拖拽选区边框 -->
    <Border x:Name="SelectionBorder"
            BorderBrush="#FF00FFAA"
            BorderThickness="2"
            Background="#2200FFAA"
            Visibility="Collapsed"/>

    <!-- 选区尺寸提示 -->
    <Border x:Name="SizeTipBorder"
            Background="#DD000000"
            CornerRadius="3"
            Padding="6,2"
            Visibility="Collapsed">
      <TextBlock x:Name="SizeTipText" Foreground="#FF00FFAA" FontSize="12"/>
    </Border>
  </Canvas>
</Window>
